{
  "name": "crunch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first inspiration canvas",
  "engines": {
    "node": ">=22.18 <27"
  },
  "scripts": {
    "dev": "node --watch-path=server server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/main.ts",
